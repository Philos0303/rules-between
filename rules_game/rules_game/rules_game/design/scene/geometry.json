{
  "metadata": {
    "document": "Night 1 metric layout and modeling reference",
    "version": "1.1-layout-reference",
    "coordinate_system": "Blender: X east, Y north, Z up; units are metres.",
    "geometry_basis": "All room polygons describe structural wall centerlines at the room perimeter, or site boundary centerlines outdoors. Shared rooms use the same centerline once. Finished clear walkable faces are produced by offsetting each interior wall centerline inward by 0.10 m and each exterior wall centerline inward by 0.15 m; do not offset two adjacent rooms independently. Listed room dimensions are therefore centerline dimensions, not promised net-area measurements.",
    "floor_levels": {
      "ground_z": 0.0,
      "upper_z": 3.6,
      "typical_clear_height": 3.2
    },
    "opening_edge_convention": "For every planar opening, center[0:2] lies on the listed common wall-centerline boundary: axis X means the boundary is constant-Y and the opening extends along X; axis Y means the boundary is constant-X and the opening extends along Y. center[2] is the finished-floor bottom elevation. Width is the clear opening measured along axis; height is clear vertical opening. D20 is the sole vertical-circulation exception: its center is the upper-floor landing threshold at z=3.60, inside the S/U1 stacked footprint.",
    "window_convention": "Each window center is [X,Y,Z] at the geometric centre of the glazed opening. sill is its finished-floor bottom elevation above its room z; thus center[2] must equal room.z + sill + height/2. axis uses the same wall convention as openings. A window must lie on an exterior wall-centerline, not a room-to-room partition or door span. view_to names the first authored exterior zone reached by a perpendicular sight ray; it does not imply a walkable connection.",
    "structural_support": {
      "upper_front_guest_wing": "U2, U4 and U7 project south of the ground-storey facade over a covered front porte-cochere/veranda. This is a supported two-storey bay, not a cantilever: 300 mm rendered masonry piers/columns are required at (-3.7,-3.2), (-0.6,-3.2), (2.1,-3.2), (5.0,-3.2) and (7.4,-2.0), tied to a front beam below the upper facade. The north edge bears on the F1/F2/F8 ground walls.",
      "upper_rear_chain": "S extends north to y=6.40 as an enclosed stair/storey base, directly carrying U6. U8 bears on F5/F6/F2/F3; U5 bears on F3/F4; U3 bears on F4 plus the F9/F10 service-wing wall. U8 is a 2.80 m deep covered balcony supported by the lower living/kitchen beam grid; it has no unsupported free span beyond 2.80 m.",
      "stair_and_history_wall": "S is 4.00 m by 5.80 m at ground level. Its two non-overlapping 2.00 m flights and 1.30 m turning landing sit in the south stair void. The upper floor slab excludes their entire x=-3.55..-0.25, y=0.80..3.20 envelope. The north portion is enclosed stair-store support below U6. The history observation wall is a north full-height wall at y=4.40, with a 0.95 m wide by 2.15 m high clear wall field; it is not under either stair flight, landing or upper platform."
    },
    "building_intent": "An asymmetric 1930s Shanghai villa: a compact main living block, a west/rear kitchen wing, and a narrower east service wing. Four guest rooms are U2-U5. U5 is the retained original principal bedroom. U8 is an open covered balcony, not an extra enclosed room.",
    "scope_note": "Current design baseline derived from the confirmed Night 1 playthrough. It is not a surveyed building and does not claim as-built measurement verification."
  },
