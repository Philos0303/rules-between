  "adjustments": [
    {
      "id": "A01",
      "status": "no_playthrough_change",
      "decision": "All 25 functional IDs and all 28 normal adjacencies from the Night 1 playthrough draft are retained.",
      "reason": "The approved surface and hidden routes remain executable without adding a service stair, basement or second building."
    },
    {
      "id": "A02",
      "status": "metric_resolution",
      "decision": "F1 is an L-shaped arrival hall; it shares its north edge with F2 and F8 and its west edge with the main stair.",
      "reason": "This supplies the previously abstract F1-F2, F1-F8 and F1-S links as real shared-wall doors while preserving a modest villa entrance."
    },
    {
      "id": "A03",
      "status": "metric_resolution",
      "decision": "The kitchen wing sits north-west of the living block and the narrow service wing sits east; O2 is north, O3 is its east-side alley, O4 is north-east, and O5 runs down the east service side.",
      "reason": "The external return loop has real exterior gates and leaves O4 reachable from both directions. O4 contains the tree and drainage ditch required by N6."
    },
    {
      "id": "A04",
      "status": "metric_resolution",
      "decision": "U6, U8 and U5 form one north-side chain above the rear half of the house. U8 is an open covered balcony. U3 is placed at the north-east end of U1.",
      "reason": "The N5 safe bypass becomes physically legible, while U3, U6 and U8 each have a north-facing view toward O2 as required by the evidence route."
    },
    {
      "id": "A05",
      "status": "implementation_constraint",
      "decision": "S is the only vertical connection. Its explicit `stair` geometry uses two 9-riser, 2.00 m runs, a 1.30 m turning landing, a 1.15 m clear stair width, and a defined U1 slab exclusion at z=3.60.",
      "reason": "The stair now has dimensional flight, landing and floor-hole data rather than an unverified textual claim. No service stair or basement is introduced."
    },
    {
      "id": "A06",
      "status": "implementation_constraint",
      "decision": "历史墙在S前室北侧y=4.40，0.95m宽2.15m高，避开梯段与平台。",
      "reason": "Supports H3/H6 with adequate headroom and keeps Night 2 outside this production scope."
    },
    {
      "id": "A07",
      "status": "implementation_constraint",
      "decision": "F2 has no exterior window because it is enclosed by the living loop. Daylight is supplied by a glazed transom above D09 (F1-F2); it is an interior borrowed-light element and is deliberately absent from `windows`.",
      "reason": "Prevents a false exterior window in the surface-route room while retaining a plausible renovated-villa lighting condition."
    }
  ],
